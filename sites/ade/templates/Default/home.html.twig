<div class="container wrapper">
    <div class="row">
        <div class="col-12 offset-md-2 col-md-8">
        {% if sourcesTimeline is not empty %}
            <h3 class="mt-5 pb-3">{{ 'Interviews'|trans }}</h3>
            <div class="container-fullwidth">
                <div class="row">
                {% for source in sourcesTimeline %}
                    {% set path = path('source', { 'uid' : source.uid }) %}
                    {% set thumb = '/viewer/source-%05d/thumb.jpg'|format(source.uid|u.replaceMatches('/.*source\-/', '').__toString) %}
                    <div class="col-12 col-md-6 mb-5" style="overflow: hidden;">
                        <a href="{{ path }}" class="play-icon {% if source.sourceType is not empty %}sourcetype-{{ source.sourceType|lower }}{% endif %}">
                        {% if file_exists(webDir ~ thumb) %}
                            <div class="ratio ratio-4x3 mb-1" alt="" style="background: url({{ app.request.basepath }}{{ thumb }}); background-size: cover; ">
                            {% if source.sourceType is not empty %}
                                <div class="play-icon-overlay">{{ source.sourceType|capitalize }}</div>
                            {% endif %}
                            </div>
                        {% endif %}
                            {{ source.name }}
                        </a>
                    </div>
                {% endfor %}
                </div><!-- .row -->
            </div><!-- .container-fluid -->
        {% endif %}
        </div>
    </div>
{% endblock %}
