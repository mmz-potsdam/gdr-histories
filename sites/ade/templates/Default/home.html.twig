{% extends '@TeiEdition/Default/base.html.twig' %}

{% import '@TeiEdition/Shared/map-leaflet.html.twig' as map %}
{% import '@TeiEdition/Shared/helper.html.twig' as helper %}

{% block head %}
    {{ map.head() }}
    {{ map.head_markercluster() }}

    <script src="{{ app.request.basepath }}/js/blazy.min.js"></script>
{% endblock %}

{% block contenttop %}
{% embed '@TeiEdition/Default/contenttop_skeleton.html.twig' %}
    {% block carousel %}
    <div id="carousel" class="carousel slide" data-ride="carousel">
    {#
        <ol class="carousel-indicators">
            <li data-target="#carousel" data-slide-to="0" class="active"></li>
            <li data-target="#carousel" data-slide-to="1"></li>
            <li data-target="#carousel" data-slide-to="2"></li>
        </ol>
    #}
        <div class="carousel-inner">
            <div class="carousel-item active d-flex" style="background-image: url('{{ app.request.basepath }}/viewer/home/banner-archiv-der-erinnerung.png');">
                <div class="container">
                <blockquote class="blockquote ps-5">
                    <p>
                        Überlebende der Schoa erinnern sich&#x2026;
                    </p>
                </blockquote>
                </div>
            </div>
        </div>
    </div><!-- #carousel -->
    {% endblock %}
{% endembed %}
{% endblock %}

{% block body %}
    <div class="row">
        <div id="col-main" class="col-12 offset-md-2 col-md-8">
            <h4>{{ 'Welcome'|trans }}</h4>
            <h2>{{ siteName|trans({}, 'additional') }}</h2>
            <div class="two-columns-disabled justify-hyphens">
                <p class="dta-p">
                    Das digitale Projekt geht zurück auf die in den Jahren 1995–1997 mit dem Fortunoff Video Archive for Holocaust Testimonies (Yale University) aufgebaute Interviewsammlung  „Archiv der Erinnerung. Interviews mit Überlebenden der Shoah“. Damals entstanden 78 videographierte Interviews mit meist in der Region Berlin-Brandenburg lebenden jüdischen Zeitzeuginnen und Zeitzeugen. Mit der Online-Stellung von sechs exemplarischen Interviews des „Archivs der Erinnerung“ schafft das Moses Mendelssohn Zentrum für europäisch-jüdische Studien (MMZ) neue Zugänge zum ursprünglichen Projekt. Das Portal enthält zusätzlich erweiterte Informationen sowie Unterrichtsmaterialien zu diesen ausgewählten Interviews. Zudem wird es kontinuierlich um Bildungsmaterialien, auch aus anderen Projekten des MMZ, erweitert.
                </p>
                <p>
                    <a href="{{ path('about') }}#section-0">Mehr...</a>
                </p>
            </div>
        </div>
    </div>
</div><!-- .container.wrapper -->
