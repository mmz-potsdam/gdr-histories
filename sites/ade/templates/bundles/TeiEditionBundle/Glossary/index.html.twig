{% extends '@TeiEdition/Default/base.html.twig' %}

{% block contenttop %}
    <div class="jumbotron pt-5 pb-3">
        <div class="container">
            <div class="row">
                <div class="col offset-md-2 col-md-9">
                    <h4>{{ 'Look-up'|trans }}</h4>
                    <h2>{{ 'Glossary' | trans }}</h2>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
    {#
    <h1>{{ 'Glossary' | trans }}</h1>
    #}
    <div class="row">
        <div class="col-sm-12">
        {% if terms is not empty %}
        {% set last_initial = '' %}
        {% for term in terms %}
            {% set initial = term.term|first|upper %}
            {% if initial != last_initial %}
                {% if last_initial != '' %}
            </ul>
                {% endif %}
            <h2>{% if initial != '"' %}{{ initial }}{% endif %}</h2>
            {% set last_initial = initial %}
            <ul class="list-unstyled">
            {% endif %}
            <li>
                <b id="{{ term.slug }}">{{ term.name }}</b>{% if term.headline is not empty %} {{ term.headline }}{% endif %}{% if term.description is not empty %} {{ term.description|escape('html')|glossaryAddRefLink }}{% endif %}
            </li>
        {% endfor %}
        </ul>
        {% else %}
            {{ 'No glossary terms were found'|trans }}
        {% endif %}
        </div>
    </div><!-- .row -->
{% endblock %}
