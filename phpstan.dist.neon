includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
parameters:
    level: 5
    paths:
        - bin/
        - config/
        - public/
        - src/
    ignoreErrors:
        # doctrine/orm accepts SortDirection in findBy()/findOneBy() ordering since 3.7 but still declares the parameter as array<string, string>
        -
            message: '#^Parameter \#2 \$orderBy of method Doctrine\\ORM\\EntityRepository<.+>::find(One)?By\(\) expects array<string, string>\|null, array<string, SortDirection::(Ascending|Descending)> given\.$#'
            identifier: argument.type
            path: %currentWorkingDirectory%/src/*
